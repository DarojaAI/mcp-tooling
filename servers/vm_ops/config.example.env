# vm-ops MCP Server Configuration
# Copy this to /etc/mcp-tooling/secrets.env and fill in real values
#
# vm-ops exposes host-level operations on the same Linux VM it runs on.
# Read-only tools (get_system_info, tail_logs, list_processes,
# list_listening_ports, check_disk, get_service_status) are always
# available.
#
# Destructive tools (restart_service, kill_process) are gated by
# MCPTOOLING_CONFIRM_DESTRUCTIVE — set to 'true' only when you
# understand the operator is granting an explicit kill/restart
# capability to anyone with an MCPTOOLING_ALLOWED_TOKENS bearer token.
# Default 'false' means destructive tools return a 403-style error.

# --- MCP tooling security ---
MCPTOOLING_ALLOWED_TOKENS=token1,token2,token3

# --- Optional: per-tool allowlist (restricts which tools are exposed) ---
# MCPTOOLING_ALLOWED_TOOLS=get_system_info,tail_logs,list_processes

# --- Safety gate for destructive ops (restart_service, kill_process) ---
MCPTOOLING_CONFIRM_DESTRUCTIVE=false
